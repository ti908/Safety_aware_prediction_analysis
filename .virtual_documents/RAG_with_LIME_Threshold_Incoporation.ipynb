def build_embeddings(texts):
    """Load SentenceTransformers from a LOCAL directory only; else TF-IDF fallback."""
    try:
        from sentence_transformers import SentenceTransformer
        import torch
        # pick best available device
        if torch.backends.mps.is_available():
            device = "mps"
        elif torch.cuda.is_available():
            device = "cuda"
        else:
            device = "cpu"

        # IMPORTANT: pass the LOCAL PATH, not the model id
        log(f"[info ] Loading local SentenceTransformer('{MODEL_DIR}') on device='{device}' …")
        with timed("Load ST model (local)"):
            st = SentenceTransformer(str(MODEL_DIR), device=device)  # <--- local path

        # Manual batching + tqdm progress (reliable in Jupyter)
        try:
            from tqdm.auto import tqdm
        except Exception:
            def tqdm(x, **kw): return x

        batch_size = 256 if device in ("mps","cuda") else 64
        dim = st.get_sentence_embedding_dimension()
        N = len(texts)
        emb = np.empty((N, dim), dtype=np.float32)

        log(f"[info ] Embedding {N} chunks in batches of {batch_size} (dim={dim}). RAM: {mem()}")
        with timed("Encode (SentenceTransformers, local)"):
            import torch
            with torch.inference_mode():
                idx = 0
                for i in tqdm(range(0, N, batch_size), desc="Embedding", leave=True):
                    batch = texts[i:i+batch_size]
                    batch_emb = st.encode(
                        batch,
                        convert_to_numpy=True,
                        normalize_embeddings=True,
                        show_progress_bar=False,   # tqdm handles the bar
                        batch_size=batch_size
                    )
                    emb[idx:idx+len(batch_emb)] = batch_emb
                    idx += len(batch_emb)

        log(f"[info ] Embedding complete. RAM: {mem()}")
        return {"backend":"st","model":"all-MiniLM-L6-v2","emb":emb,"device":device}

    except Exception as e:
        log(f"[note ] Using TF-IDF fallback (local ST load failed). Reason: {e!r}")
        with timed("TF-IDF fit_transform"):
            vec = TfidfVectorizer(max_features=4096, ngram_range=(1,2))
            mat = vec.fit_transform(texts).astype(np.float32)
        log(f"[info ] TF-IDF matrix shape: {mat.shape}. RAM: {mem()}")
        return {"backend":"tfidf","vec":vec,"emb":mat}









# ---- Safety keyword sets used to bias retrieval ranking ----
SAFETY_TERMS = [
    "lockout", "tagout", "shutdown", "isolation", "hazard", "danger",
    "safety", "ppe", "permit", "confined space", "emergency stop"
]
FAILURE_TERMS = [
    "overstrain", "overload", "torque", "bearing", "vibration", "misalignment",
    "heat dissipation", "overheat", "temperature", "lubrication", "power", "rpm"
]

def safety_rerank(chunks_df: pd.DataFrame, boost_terms, boost_factor=0.85):
    """
    Multiply distance by boost_factor (smaller is better) if text matches safety terms.
    """
    if chunks_df.empty:
        return chunks_df
    pat = re.compile("|".join(re.escape(t) for t in boost_terms), flags=re.IGNORECASE)
    d = chunks_df.copy()
    hit = d["text"].fillna("").apply(lambda t: bool(pat.search(t)))
    # reduce distance for hits => better rank
    if "hybrid_dist" in d.columns:
        d.loc[hit, "hybrid_dist"] = d.loc[hit, "hybrid_dist"] * boost_factor
    d["safety_hit"] = hit.astype(int)
    return d.sort_values(["hybrid_dist", "safety_hit"], ascending=[True, False])


